# Rust
/target/

# Python
__pycache__/
*.py[cod]
*.so
*.pyd
.venv/
venv/
dist/
build/
*.egg-info/
.pytest_cache/

# OS / editor
.DS_Store
.idea/
.vscode/

# Local leftovers
*.orig
*.rej
*.patch
/reports/

# Benchmark: downloaded corpora (re-created by `python -m chunkbench fetch`, pinned in corpora.lock.json)
/benchmarks/corpora/
# Benchmark: CI output (uploaded as a workflow artifact instead)
/benchmarks/ci_results/

# macOS
.DS_Store
benchmarks/results/*/_cache/
/benchmarks/cross_tokenizer_ci_results/
/tokenizer_benchmarks/results/
# Downloaded tokenizer files are fetched on demand; the lock file (hashes) is committed.
/benchmarks/tokenizers/*.json
!/benchmarks/tokenizers/tokenizers.lock.json
